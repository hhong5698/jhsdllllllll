<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>IFL Planer-Edu App Season 2</title>
<style>
  :root{
    --bg1:#0f172a; --bg2:#1e1b4b; --gold:#fbbf24;
    --grammar1:#6366f1; --grammar2:#a855f7;
    --vocab1:#10b981; --vocab2:#22d3ee;
    --reading1:#f97316; --reading2:#facc15;
  }
  *{box-sizing:border-box;}
  body{
    margin:0; min-height:100vh; font-family:'Segoe UI',system-ui,-apple-system,sans-serif;
    background:
      radial-gradient(circle at 15% 8%, rgba(99,102,241,.35) 0%, transparent 40%),
      radial-gradient(circle at 88% 15%, rgba(34,211,238,.30) 0%, transparent 40%),
      radial-gradient(circle at 50% 95%, rgba(249,115,22,.20) 0%, transparent 45%),
      linear-gradient(160deg, var(--bg1), var(--bg2));
    background-attachment:fixed;
    color:#e2e8f0;
  }
  header{ text-align:center; padding:50px 20px 26px; }
  .logo-wrap{
    display:flex; align-items:center; justify-content:center; gap:16px; flex-wrap:wrap;
  }
  .logo-wrap img{
    width:78px; height:78px; border-radius:18px; box-shadow:0 8px 24px rgba(251,191,36,.35);
  }
  header h1{
    margin:0; font-size:2.5rem; font-weight:800; letter-spacing:-0.5px;
    background:linear-gradient(90deg,#fcd34d,#a5b4fc,#67e8f9);
    -webkit-background-clip:text; background-clip:text; color:transparent;
  }
  header .tagline{
    margin-top:6px; color:#fcd34d; font-weight:600; font-size:.95rem; letter-spacing:.5px;
    text-transform:uppercase;
  }
  header p{ margin:14px auto 0; max-width:560px; color:#94a3b8; font-size:1.05rem; }

  .grid{
    max-width:1120px; margin:0 auto; padding:24px 24px 80px;
    display:grid; grid-template-columns:repeat(auto-fit,minmax(300px,1fr)); gap:30px;
  }
  .card{
    border-radius:22px; padding:2px; position:relative; overflow:hidden; cursor:pointer;
    transition:transform .28s ease, box-shadow .28s ease;
    box-shadow:0 14px 34px rgba(0,0,0,.35);
  }
  .card:hover{ transform:translateY(-10px) scale(1.015); box-shadow:0 24px 55px rgba(0,0,0,.5); }

  .card.grammar{ background:linear-gradient(135deg,var(--grammar1),var(--grammar2)); }
  .card.vocab{ background:linear-gradient(135deg,var(--vocab1),var(--vocab2)); }
  .card.reading{ background:linear-gradient(135deg,var(--reading1),var(--reading2)); }

  .card-inner{
    background:#0f1425; border-radius:20px; padding:30px 26px 28px; height:100%;
    position:relative; z-index:1;
  }
  .card.grammar .card-inner{ background:linear-gradient(165deg,#161233,#0f1425 70%); }
  .card.vocab .card-inner{ background:linear-gradient(165deg,#08201c,#0f1425 70%); }
  .card.reading .card-inner{ background:linear-gradient(165deg,#241405,#0f1425 70%); }

  .glow{
    position:absolute; width:180px; height:180px; border-radius:50%; filter:blur(60px);
    opacity:.35; top:-60px; right:-60px; z-index:0;
  }
  .card.grammar .glow{ background:var(--grammar2); }
  .card.vocab .glow{ background:var(--vocab2); }
  .card.reading .glow{ background:var(--reading2); }

  .icon{
    width:74px; height:74px; border-radius:18px; display:flex; align-items:center; justify-content:center;
    margin-bottom:18px; position:relative; z-index:1; overflow:hidden;
    background:#fdfaf3;
    box-shadow:0 8px 20px rgba(0,0,0,.4);
  }
  .icon img{ width:100%; height:100%; object-fit:cover; }

  .card h2{ margin:0 0 8px; font-size:1.4rem; color:#f8fafc; position:relative; z-index:1; }
  .card p{ margin:0 0 22px; color:#cbd5e1; font-size:.95rem; line-height:1.55; position:relative; z-index:1; }

  .tags{ display:flex; gap:8px; flex-wrap:wrap; margin-bottom:24px; position:relative; z-index:1; }
  .tag{
    font-size:.72rem; padding:5px 12px; border-radius:999px; font-weight:700; color:#0f1425;
    background:rgba(255,255,255,.85);
  }
  .card.grammar .tag{ background:#c7d2fe; }
  .card.vocab .tag{ background:#a7f3d0; }
  .card.reading .tag{ background:#fed7aa; }

  .go{
    display:inline-flex; align-items:center; gap:8px; font-weight:800; font-size:.95rem;
    padding:11px 20px; border-radius:12px; color:#fff; position:relative; z-index:1;
    transition:transform .2s ease;
  }
  .card.grammar .go{ background:linear-gradient(90deg,var(--grammar1),var(--grammar2)); }
  .card.vocab .go{ background:linear-gradient(90deg,var(--vocab1),var(--vocab2)); }
  .card.reading .go{ background:linear-gradient(90deg,var(--reading1),var(--reading2)); }
  .card:hover .go{ transform:translateX(4px); }

  footer{ text-align:center; padding:26px; color:#64748b; font-size:.85rem; }

  /* Viewer overlay */
  #viewer{
    position:fixed; inset:0; background:#0f172a; display:none; flex-direction:column; z-index:999;
  }
  #viewer.open{ display:flex; }
  .viewer-bar{
    display:flex; align-items:center; gap:14px; padding:10px 18px;
    background:#111827; border-bottom:1px solid #1f2937;
  }
  .back-btn{
    background:#374151; color:#e5e7eb; border:none; padding:9px 16px; border-radius:10px;
    font-weight:600; cursor:pointer; font-size:.9rem; display:flex; align-items:center; gap:6px;
  }
  .back-btn:hover{ background:#4b5563; }
  .viewer-title{ color:#f1f5f9; font-weight:700; font-size:1rem; }
  #viewer iframe{ flex:1; width:100%; border:none; background:#fff; }

  /* Login gate */
  #loginGate{
    position:fixed; inset:0; z-index:2000; display:flex; align-items:center; justify-content:center;
    background:
      radial-gradient(circle at 15% 8%, rgba(99,102,241,.35) 0%, transparent 40%),
      radial-gradient(circle at 88% 15%, rgba(34,211,238,.30) 0%, transparent 40%),
      linear-gradient(160deg, var(--bg1), var(--bg2));
    padding:20px;
  }
  .login-card{
    background:#0f1425; border:1px solid rgba(255,255,255,.1); border-radius:22px;
    padding:38px 34px; max-width:380px; width:100%; box-shadow:0 20px 60px rgba(0,0,0,.5);
    text-align:center;
  }
  .login-card img{ width:64px; height:64px; border-radius:14px; margin-bottom:14px; }
  .login-card h2{ margin:0 0 4px; color:#f8fafc; font-size:1.3rem; }
  .login-card .sub{ color:#94a3b8; font-size:.85rem; margin-bottom:22px; }
  .login-card label{ display:block; text-align:left; color:#cbd5e1; font-size:.82rem; font-weight:700; margin:14px 0 6px; }
  .login-card input{
    width:100%; padding:12px 14px; border-radius:10px; border:1px solid #334155;
    background:#1e293b; color:#f1f5f9; font-size:.95rem;
  }
  .login-card input:focus{ outline:2px solid #818cf8; border-color:#818cf8; }
  .login-btn{
    margin-top:22px; width:100%; padding:13px; border:none; border-radius:12px;
    background:linear-gradient(90deg,#6366f1,#38bdf8); color:#fff; font-weight:800; font-size:1rem;
    cursor:pointer;
  }
  .login-btn:hover{ opacity:.92; }
  .login-err{ color:#f87171; font-size:.85rem; margin-top:12px; min-height:18px; font-weight:600; }
  #hubContent{ display:none; }
</style>
</head>
<body>

<div id="loginGate">
  <div class="login-card">
    <h1>IFL Planer-Edu App Season 2</h1>
  </div>
  <div class="tagline">Your education is our priority!</div>
  <p>Grammar, Vocabulary &amp; Reading practice — all in one place.</p>
</header>

<div class="grid">
  <div class="card grammar" onclick="openApp('grammar','Grammar App')">
    <div class="glow"></div>
    <div class="card-inner">
      <div class="icon"><img 
const APP_PASSWORD = "iflplaner2026";
let CURRENT_STUDENT = "";

function attemptLogin(){
  const name = document.getElementById('loginName').value.trim();
  const pass = document.getElementById('loginPass').value;
  const err = document.getElementById('loginErr');
  if(!name){ err.textContent = "⚠ Please enter your full name."; return; }
  if(pass !== APP_PASSWORD){ err.textContent = "⚠ Incorrect password. Please try again."; return; }
  err.textContent = "";
  CURRENT_STUDENT = name;
  try{ sessionStorage.setItem('ifl_student', name); }catch(e){}
  document.getElementById('loginGate').style.display = 'none';
  document.getElementById('hubContent').style.display = 'block';
}

(function(){
  try{
    const saved = sessionStorage.getItem('ifl_student');
    if(saved){
      CURRENT_STUDENT = saved;
      document.getElementById('loginGate').style.display = 'none';
      document.getElementById('hubContent').style.display = 'block';
    }
  }catch(e){}
})();

document.getElementById('loginPass').addEventListener('keydown', function(e){
  if(e.key === 'Enter') attemptLogin();
});

function openApp(key, title){
  document.getElementById('viewerFrame').src = APPS[key];
  document.getElementById('viewerTitle').textContent = title;
  document.getElementById('viewer').classList.add('open');
}
function closeApp(){
  document.getElementById('viewer').classList.remove('open');
  document.getElementById('viewerFrame').src = '';
}
</script>

</body>
</html>


